CREATE QUERY similar_closed_cases(VERTEX<Card> c, VERTEX<Customer> cust) FOR GRAPH FraudGraph {
    /* Finds closed cases connected directly or via customer to the card under investigation */
    CardSet = {c};
    CustSet = {cust};
    
    DirectCases = SELECT cs FROM CardSet:s -(INVOLVES_CARD)- FraudCase:cs;
    CustCases = SELECT cs FROM CustSet:s -(INVOLVES_CUSTOMER)- FraudCase:cs;
    
    PRINT DirectCases, CustCases;
}
