# Gemini API Key (Required for LLM synthesis)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# TigerGraph Connection Config (Primary Analytical Source of Truth)
TIGERGRAPH_HOST=http://localhost
TIGERGRAPH_RESTPP_PORT=9000
TIGERGRAPH_GS_PORT=14240
TIGERGRAPH_USERNAME=tigergraph
TIGERGRAPH_PASSWORD=tigergraph
TIGERGRAPH_GRAPH_NAME=FraudGraph
TIGERGRAPH_SECRET=
TIGERGRAPH_API_TOKEN=

# Fallback & Resilience Policy (fallback | fail_closed)
# - fallback: Silently or warningly use local pandas if TigerGraph is unreachable (default for dev/test)
# - fail_closed: Raise TigerGraphUnavailableError on connection/query failure (recommended for production)
TIGERGRAPH_FALLBACK_POLICY=fallback

# Agent Reasoning Options
# - LLM_ENHANCED_ASSESSMENT: If true, use Gemini to synthesize hypothesis & assessment when available
LLM_ENHANCED_ASSESSMENT=false

# Backend & Persistence Settings
DATA_REPOSITORY_BACKEND=tigergraph
CHECKPOINT_BACKEND=sqlite
API_AUTH_KEY=generate-a-long-random-secret-key-for-api-auth

# Simulation Mode (true for synthetic/replay tests, false for live LLM calls)
SIMULATION_MODE=false

# Paths
DATASET_DIR=Dataset
REGULATIONS_DIR=regulations
ANSWERS_DIR=answers
MEMORY_FILE=memory/case_memory.json
